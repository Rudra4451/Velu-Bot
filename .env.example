# ─────────────────────────────────────────────
# Velu Bot — Environment Configuration
# ─────────────────────────────────────────────

# ── Required ──────────────────────────────────
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_application_id_here

# ── Optional: Development ─────────────────────
# Set a guild ID for instant slash command registration during development
# Leave empty in production (global registration is automatic)
DISCORD_GUILD_ID=

# ── Optional: Database ────────────────────────
# Supabase provides persistent storage across restarts
# If not set, the bot runs fully in-memory (data resets on restart)
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_service_role_key_here

# ── Optional: Stickers & GIFs ────────────────
# Klipy API key adds a third sticker provider alongside Waifu.pics and Giphy
KLIPY_API_KEY=your_klipy_api_key_here

# ── Chat Prefix Commands ─────────────────────
BOT_PREFIX=?
BOT_PREFIXES=?,!,$,&

# ── Logging ───────────────────────────────────
# Levels: debug, info, warn, error
LOG_LEVEL=info
