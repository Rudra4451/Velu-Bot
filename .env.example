# Discord API Credentials
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here

# Optional: Guild ID for faster slash command registration during development
DISCORD_GUILD_ID=your_development_guild_id_here

# Logger settings: debug, info, warn, error
LOG_LEVEL=debug

# Optional: Klipy API Key for premium social command gifs
KLIPY_API_KEY=your_klipy_api_key_here
