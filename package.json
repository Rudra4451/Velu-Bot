{
  "name": "velu-bot",
  "version": "3.0.0",
  "description": "Velu — Premium Music, Security & Games Discord Bot. 37 slash commands, studio 48kHz audio, multi-engine search, autoplay, auto-mod, mini-games & 24/7 uptime.",
  "main": "index.ts",
  "type": "module",
  "scripts": {
    "start": "node --max-old-space-size=512 --enable-source-maps dist/index.js",
    "dev": "NODE_OPTIONS='--max-old-space-size=512' tsx watch index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "deploy": "tsx src/scripts/deploy.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Rudra4451/Velu-Bot.git"
  },
  "keywords": [
    "discord",
    "discord-bot",
    "music-bot",
    "moderation",
    "discord.js",
    "typescript",
    "games",
    "autoplay",
    "slash-commands"
  ],
  "author": "Rudra4451",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Rudra4451/Velu-Bot/issues"
  },
  "homepage": "https://github.com/Rudra4451/Velu-Bot#readme",
  "dependencies": {
    "@discord-player/extractor": "^7.2.0",
    "@discordjs/voice": "^0.19.2",
    "@distube/ytdl-core": "^4.16.12",
    "@evan/opus": "^1.0.3",
    "@supabase/supabase-js": "^2.110.3",
    "cors": "^2.8.6",
    "discord-player": "^7.2.0",
    "discord.js": "^14.15.3",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "ffmpeg-static": "^5.3.0",
    "kazagumo": "^3.4.3",
    "libsodium-wrappers": "^0.8.4",
    "play-dl": "^1.9.7",
    "poru": "^5.3.0",
    "shoukaku": "^4.3.0",
    "youtube-dl-exec": "^3.1.9",
    "youtube-ext": "^1.1.25",
    "ytdl-core": "^4.11.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
